\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{calc}
\RequirePackage{pgfopts}
\RequirePackage{hyperref}
\RequirePackage{changepage}

\hypersetup{
  colorlinks,
  allcolors=.,
  urlcolor=blue,
}

\usetikzlibrary{calc}

\newtoggle{sponsor cern}
\newtoggle{sponsor ngt}
\newtoggle{sponsor jgu}
\newtoggle{sponsor bmbf}
\newtoggle{sponsor fsp}

\pgfkeys{
  /shiva/inner/sponsor/.cd,
    cern/.is choice,
    cern/true/.code=\toggletrue{sponsor cern},
    cern/false/.code=\togglefalse{sponsor cern},
    cern=true,
    ngt/.is choice,
    ngt/true/.code=\toggletrue{sponsor ngt},
    ngt/false/.code=\togglefalse{sponsor ngt},
    ngt=true,
    jgu/.is choice,
    jgu/true/.code=\toggletrue{sponsor jgu},
    jgu/false/.code=\togglefalse{sponsor jgu},
    jgu=true,
    bmbf/.is choice,
    bmbf/true/.code=\toggletrue{sponsor bmbf},
    bmbf/false/.code=\togglefalse{sponsor bmbf},
    bmbf=true,
    fsp/.is choice,
    fsp/true/.code=\toggletrue{sponsor fsp},
    fsp/false/.code=\togglefalse{sponsor fsp},
    fsp=true
}

\setbeamertemplate{title sponsors}{
  \hfill
  \vspace*{0.5em}
  \iftoggle{sponsor ngt}{%
  \hspace*{5mm}
  $\vcenter{\hbox{\includegraphics[height=1.5cm]{theme/assets/sponsors/ngt_square.pdf}}}$
  }{}
  \iftoggle{sponsor cern}{%
  % \hspace*{5mm}
  $\vcenter{\hbox{\includegraphics[height=1.5cm]{theme/assets/sponsors/cern.pdf}}}$
  \hspace*{-3.4mm}
  }{}
}

\setbeamertemplate{title page}{%
  \hspace*{0.7em}
  \begin{minipage}[t][\paperheight]{\textwidth-2em}
    {\linespread{1.1}\usebeamerfont{title}\usebeamercolor[fg]{title}\vspace*{1em}\inserttitle\par}
    \vspace*{2em}
    \tikzset{external/export next=false}
    \begin{tikzpicture}
      \node[fill=title.fg,minimum width=\textwidth,minimum height=3pt,inner sep=0] (hline) at (0,0) {};
      \node[anchor=north east,inner sep=0] (affiliation) at ($(hline.south east)+(0,-1em)$) {
        \usebeamertemplate*{title sponsors}
        % \includegraphics[width=1.5cm]{theme/assets/sponsors/cern.pdf}
      };
      \node[anchor=north west,inner sep=0,align=left] (author) at ($(hline.south west) + (0,-1em)$) {
        \insertauthor \\
        {\footnotesize \insertinstitute} \\
        \insertdate
      };
    \end{tikzpicture}
  \end{minipage}
  \iftoggle{sponsor bmbf}{%
  \tikz[overlay,remember picture]{
    \node[anchor=south,inner sep=0pt] at ($(current page.south) + (0em, 0.1em)$) {\tiny This work has been sponsored by the Wolfgang Gentner Programme of the German Federal Ministry of Education and Research };
  }
  }{}%
}

\def\maketitle{%
  \ifbeamer@inframe
    \titlepage
  \else
    \frame[plain,noframenumbering]{\titlepage}
  \fi
}

\def\titlepage{%
  \usebeamertemplate{title page}
}

\setbeamertemplate{section page}{
  \begin{center}
    \usebeamercolor[fg]{section title}
    \usebeamerfont{section title}
    \insertsectionhead\par
    \ifx\insertsubsectionhead\@empty\else
      \usebeamercolor[fg]{subsection title}
      \usebeamerfont{subsection title}
      \insertsubsectionhead
    \fi
  \end{center}
}

\AtBeginSection{
  \ifbeamer@inframe
    \sectionpage
  \else
    \frame[plain,c,noframenumbering]{\sectionpage}
  \fi
}

\settowidth{\leftmargini}{\usebeamertemplate{itemize item}}
\setbeamertemplate{itemize item}{%
    \usebeamercolor[fg]{title}%
    \raisebox{0.1em}{%
    \scriptsize$\blacksquare$}%
}
\settowidth{\leftmarginii}{\usebeamertemplate{itemize subitem}}
\setbeamertemplate{itemize subitem}{%
    \usebeamercolor[fg]{title}%
    \raisebox{0.1em}{%
    \scriptsize$\blacktriangleright$}%
}
\settowidth{\leftmarginiii}{\usebeamertemplate{itemize subsubitem}}
\setbeamertemplate{itemize subsubitem}{%
    \usebeamercolor[fg]{title}%
    \raisebox{0.1em}{%
    \scriptsize$\bullet$}%
}


\addtobeamertemplate{block begin}
  {}
  {
    \vspace{0.3em}
    \begin{adjustwidth}{0.3cm}{0.3cm}
  }
  
\addtobeamertemplate{block end}
  {
    \end{adjustwidth}
    \vspace{0.3em}
  }
  {}

\addtobeamertemplate{block alerted begin}
  {}
  {
    \vspace{0.3em}
    \begin{adjustwidth}{0.3cm}{0.3cm}
  }
  
\addtobeamertemplate{block alerted end}
  {
    \end{adjustwidth}
    \vspace{0.3em}
  }
  {}

