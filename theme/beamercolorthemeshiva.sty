\definecolor{shivablue}{RGB}{34,82,158}

\definecolor{mDarkTeal}{HTML}{23373b}

\definecolor{alertred}{HTML}{EF5D60}

\setbeamercolor{normal text}{%
  fg=mDarkTeal,
  bg=black!2
}
\usebeamercolor[fg]{normal text}

\setbeamercolor{alerted text}{fg=LimeGreen}
\setbeamercolor{block body alerted}{bg=alertred!20}
\setbeamercolor{block title alerted}{bg=alertred}

\setbeamercolor{block body}{bg=shivablue!30}
\setbeamercolor{block title}{bg=shivablue,fg=white}
\setbeamercolor{block body example}{bg=green!10}
\setbeamercolor{block title example}{bg=green!20}

\setbeamercolor{titlelike}{use=normal text, parent=normal text}
\setbeamercolor{author}{use=normal text, parent=normal text}
\setbeamercolor{date}{use=normal text, parent=normal text}
\setbeamercolor{institute}{use=normal text, parent=normal text}
\setbeamercolor{structure}{use=normal text, fg=normal text.fg}


\setbeamercolor{palette primary}{%
  use=normal text,
  fg=shivablue,
  bg=normal text.fg
}

\setbeamercolor{frametitle}{%
  fg=shivablue
}

\setbeamercolor{title}{%
  fg=shivablue  
}

\setbeamercolor{section title}{%
  fg=shivablue  
}

\setbeamercolor{footline}{%
  fg=white,
  bg=shivablue
}
