\RequirePackage{tikz}
\RequirePackage{pgfopts}

\usetikzlibrary{calc,external}

\setbeamersize{text margin left=8mm,text margin right=8mm} 

\def\insertframetitle{}

\setbeamertemplate{frametitle}[leftskip=0]{%
  \begin{beamercolorbox}[wd=\textwidth]{frametitle}%
  \insertframetitle
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\textwidth,ht=2em]{footline}%
    \usebeamerfont{page number in head/foot}%
    \tikzset{external/export next=false}
    \tikz[overlay,remember picture]{%
      \node[anchor=base west,inner sep=0pt] at ($(current page.south west) + (1.0em, 0.4em)$) {\insertshortauthor};%
      \node[anchor=base,inner sep=0pt] at ($(current page.south) + (0em, 0.4em)$) {\insertshortdate};%
      \node[anchor=base east,inner sep=0pt] at ($(current page.south east) + (-1em, 0.4em)$) {\usebeamertemplate*{frame numbering}};%
    }%
  \end{beamercolorbox}%
}

\pgfkeys{
  /shiva/outer/numbering/.cd,
    .is choice,
    none/.code=\setbeamertemplate{frame numbering}[none],
    counter/.code=\setbeamertemplate{frame numbering}[counter],
    counter roman/.code=\setbeamertemplate{frame numbering}[counter roman],
    fraction/.code=\setbeamertemplate{frame numbering}[fraction],
}

\defbeamertemplate{frame numbering}{none}{}
\defbeamertemplate{frame numbering}{counter}{\insertframenumber}
\defbeamertemplate{frame numbering}{counter roman}{\romannumeral \insertframenumber}
\defbeamertemplate{frame numbering}{fraction}{
  \insertframenumber/\inserttotalframenumber
}


\AtBeginDocument{%
  \apptocmd{\appendix}{%
    \pgfkeys{%
      /shiva/outer/.cd,
      numbering=counter roman}%
    \section{Backup}
    }{}{}
}

\ProcessPgfPackageOptions{/shiva/outer}
